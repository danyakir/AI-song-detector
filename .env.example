# AudD token and ACRCloud console API token stay on the server. Never use EXPO_PUBLIC_ for credentials.
AUDD_API_TOKEN=your-audd-token
ACRCLOUD_API_TOKEN=your-acrcloud-console-token
ACRCLOUD_REGION=eu-west-1
# Optional: set this if you already created a file-scanning container in the ACRCloud console.
ACRCLOUD_CONTAINER_ID=
ACRCLOUD_CONTAINER_NAME=AI Song Detector
ACRCLOUD_BUCKET_NAME=AI Song Detector Files
PORT=8787

# Use localhost for web/simulator. For a physical phone, use this computer's LAN IP.
EXPO_PUBLIC_RECOGNITION_API_URL=http://localhost:8787

# Optional local debugging only. Recordings are not stored unless explicitly enabled.
SAVE_DEBUG_RECORDINGS=0
# DEBUG_RECORDINGS_DIR=./debug-recordings
